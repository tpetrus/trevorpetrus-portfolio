---
import Gallery from '../components/Gallery.astro';
import GeonamesCredit from '../components/GeonamesCredit.astro';
import photographyJson from '../data/gallery/photography.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseGallery } from '../lib/gallery';
import { showsGeonamesPlace } from '../lib/location';

const entries = parseGallery('photography', photographyJson);
---

<BaseLayout title="Photography" description="Photography by Trevor Petrus.">
    <h1 class="text-step-3 font-bold">Photography</h1>
    {entries.length > 0 ? (
        <div class="mt-8">
            <Gallery collection="photography" entries={entries} />
            {showsGeonamesPlace(entries) && <GeonamesCredit />}
        </div>
    ) : (
        <p class="mt-8 max-w-measure text-ink-muted">Photos are on their way.</p>
    )}
</BaseLayout>
