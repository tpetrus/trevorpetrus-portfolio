---
import PageTitle from '../components/PageTitle.astro';
import PhotographySections from '../components/PhotographySections.astro';
import photographyJson from '../data/gallery/photography.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseGallery } from '../lib/gallery';
import { PHOTOGRAPHY_TITLE_VIDEO } from '../lib/pageTitle';

const entries = parseGallery('photography', photographyJson);
---

<BaseLayout title="Photography" description="Photography by Trevor Petrus." bleed>
    {/* The ink section is part of the page, not a background change: html stays paper, so a View Transitions swap
        brings the whole section in with the new body and nothing flashes. It stacks above the decorative running
        head, which is dark on paper and would be unreadable on ink. */}
    <section class="surface-ink relative z-[1] flex flex-1 flex-col border-b border-ink-muted-on-ink/40">
        <div class="column flex-1 pt-12 pb-6 md:pt-16">
            <PageTitle text="Photography" video={PHOTOGRAPHY_TITLE_VIDEO} />
            <PhotographySections entries={entries} />
        </div>
    </section>
</BaseLayout>
