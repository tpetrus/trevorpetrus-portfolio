---
import { getCollection } from 'astro:content';

import PageTitle from '../components/PageTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionIndex from '../components/SectionIndex.astro';
import projectMetaJson from '../data/project-meta.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { numberItems } from '../lib/numbering';
import { createdFor, lastUpdatedFor, parseProjectMeta } from '../lib/projectMeta';
import { sortProjects } from '../lib/projects';

const meta = parseProjectMeta(projectMetaJson);
const projects = sortProjects((await getCollection('projects')).map(({ id, data }) => ({ id, ...data })));
// Numbers follow the repo's creation date, not `order`, so adding or reordering a project never renumbers another.
const numbered = numberItems(
    projects.map((project) => ({ ...project, key: project.id, date: createdFor(meta, project.id) })),
);
// The lowest `order` leads as the cover, so a lone project still looks intentional; the rest are the index, newest first.
const coverId = projects[0]?.id;
const cover = numbered.find(({ id }) => id === coverId);
const rows = numbered.filter(({ id }) => id !== coverId);
---

<BaseLayout title="Projects" description="Software projects by Trevor Petrus.">
    <PageTitle text="Projects" />
    {cover && (
        <div class="mt-8 flex flex-col gap-12">
            <ProjectCard
                project={cover}
                number={cover.number}
                updated={lastUpdatedFor(meta, cover.id)}
                featured
                priority
            />
            {rows.length > 0 && (
                <SectionIndex label="More projects" rows={rows.map(({ id }) => ({ id }))}>
                    {rows.map((project) => (
                        <Fragment slot={project.id}>
                            <ProjectCard
                                project={project}
                                number={project.number}
                                updated={lastUpdatedFor(meta, project.id)}
                            />
                        </Fragment>
                    ))}
                </SectionIndex>
            )}
        </div>
    )}
</BaseLayout>
