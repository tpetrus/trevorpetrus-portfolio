---
import GallerySections from '../components/GallerySections.astro';
import PageTitle from '../components/PageTitle.astro';
import artJson from '../data/gallery/art.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseGallery } from '../lib/gallery';

const entries = parseGallery('art', artJson);
---

<BaseLayout title="Art" description="Paintings, drawings and digital art by Trevor Petrus." bleed>
    {/* Same structure as the Photography page (see there for why the ink section is part of the page), with no title video. */}
    <section class="surface-ink relative z-[1] flex flex-1 flex-col border-b border-ink-muted-on-ink/40">
        <div class="column flex-1 pt-12 pb-6 md:pt-16">
            <PageTitle text="Art" />
            <GallerySections
                collection="art"
                entries={entries}
                jumpLabel="Art categories"
                emptyLine="Art is on its way."
                sectionEmptyLine={(label) => `${label} pieces are on their way.`}
            />
        </div>
    </section>
</BaseLayout>
