---
import HomeCluster from '../components/HomeCluster.astro';
import Wordmark from '../components/Wordmark.astro';
import photographyJson from '../data/gallery/photography.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseGallery } from '../lib/gallery';

const entries = parseGallery('photography', photographyJson);
---

<BaseLayout title="Home" description="Trevor Petrus: software projects and photography.">
    <Wordmark first="Trevor" second="Petrus" />
    <p class="mt-8 max-w-measure border-t border-ink pt-4 text-step-1 text-pretty">
        This site holds my photography and the software projects I build. Start with the{' '}
        <a href="/photography/" class="link">
            photographs
        </a>{' '}
        or the{' '}
        <a href="/projects/" class="link">
            projects
        </a>
        .
    </p>
    <HomeCluster entries={entries} />
</BaseLayout>
