---
import type { CollectionEntry } from 'astro:content';

import { formatDate, isoDate } from '../lib/date';
import { formatNumber } from '../lib/numbering';
import { projectHref, statusLabel } from '../lib/projects';
import Caption from './Caption.astro';
import GitHubIcon from './GitHubIcon.astro';
import ProjectScreenshot from './ProjectScreenshot.astro';

interface Props {
    project: CollectionEntry<'projects'>['data'];
    /** When the newest commit landed; the date is omitted when the sync has not recorded one. */
    updated?: Date | undefined;
    /** The cover: a large image, then a giant numeral beside the caption. Index rows draw their own number. */
    featured?: boolean;
    /** The cover's number. Ignored for index rows, where `SectionIndex` shows it. */
    number?: number | undefined;
    /** Marks the image as the likely LCP element (eager, high fetch priority). Use it for the cover only. */
    priority?: boolean;
}

const { project, updated, featured = false, number, priority = false } = Astro.props;
const { title, description, tech, status, repo, thumbnail } = project;

// The cover spans the content column (75vw from 1024px, about 1440 CSS px on a 1920 display, so up to 2880 device px); a row
// image sits in an 18rem column from `md:` and is full width below it. The width lists are what the browser may pick from:
// a 288px slot gets a 576 or 640px file, never a 2560px one. The cover tops out at 2560 because the screenshot is captured at
// 2x (2560px wide), and Astro drops widths above the source. A row goes to 960 so a 3x phone gets a sharp full-width image.
const sizes = featured
    ? '(min-width: 1024px) 75vw, calc(100vw - 2rem)'
    : '(min-width: 768px) 288px, calc(100vw - 2rem)';
const widths = featured ? [640, 960, 1280, 1920, 2560] : [320, 480, 640, 960];
// Reading order follows the DOM (WCAG 1.3.2), so the cover places the screenshot before the text and a row after it in
// the markup below, never with CSS `order`.
const screenshot = { src: thumbnail, title, widths, sizes, priority };
---

{/* The hover box is an outline, not a border: it takes no space, so nothing shifts when it appears. Padding keeps the
    content clear of the box; a negative margin cancels it (all round on the cover, vertical on a row) so the layout is
    as if there were no padding, and a row's box ends flush with the index rules. The outline is transparent at rest (not
    removed) so only its color transitions. `has-focus-visible` shows it for keyboard focus anywhere in the card. */}
<article
    class:list={[
        'relative flex flex-col gap-5 outline-1 outline-offset-0 outline-transparent transition-[outline-color] duration-150 hover:outline-ink has-focus-visible:outline-ink motion-reduce:transition-none',
        featured ? '-m-2 p-2 md:gap-8 lg:-m-3 lg:p-3' : '-my-3 p-3 md:grid md:grid-cols-[1fr_18rem]',
    ]}
>
    {featured && <ProjectScreenshot {...screenshot} />}
    <div class:list={['flex gap-gutter', featured ? 'flex-col md:flex-row md:items-end' : 'flex-col']}>
        {featured && number !== undefined && (
            <span data-index class="font-display text-step-6 leading-none font-bold tracking-tight md:min-w-[40%]">
                {formatNumber(number)}
            </span>
        )}
        <div class="flex flex-1 flex-col gap-4">
            <div class="flex items-start justify-between gap-3">
                <Caption label={statusLabel(status)}>
                    <a
                        href={projectHref(project)}
                        class="after:absolute after:inset-0 hover:underline focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:-outline-offset-4 focus-visible:after:outline-accent-deep"
                    >
                        {title}
                    </a>
                    <Fragment slot="byline">
                        <ul role="list" aria-label="Technologies" class="flex flex-wrap gap-x-3 font-mono">
                            {tech.map((name) => (
                                <li>{name}</li>
                            ))}
                        </ul>
                        {updated && (
                            <p>
                                Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
                            </p>
                        )}
                    </Fragment>
                </Caption>
                <a
                    href={repo}
                    aria-label={`${title} on GitHub`}
                    class="relative z-10 -m-1 inline-flex size-9 shrink-0 items-center justify-center text-ink-muted hover:text-ink"
                >
                    <GitHubIcon class="size-5" />
                </a>
            </div>
            <p class="max-w-measure">{description}</p>
        </div>
    </div>
    {!featured && <ProjectScreenshot {...screenshot} />}
</article>
