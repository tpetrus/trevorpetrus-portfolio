---
import type { CollectionEntry } from 'astro:content';

import { formatDate, isoDate } from '../lib/date';
import { formatNumber } from '../lib/numbering';
import { projectHref, statusLabel } from '../lib/projects';
import Caption from './Caption.astro';
import GitHubIcon from './GitHubIcon.astro';
import ProjectScreenshot from './ProjectScreenshot.astro';

interface Props {
    project: CollectionEntry<'projects'>['data'];
    /** When the newest commit landed; the date is omitted when the sync has not recorded one. */
    updated?: Date | undefined;
    /** The cover: a large image, then a giant numeral above the caption. Index rows are a number, text and image. */
    featured?: boolean;
    /** The project's number: the cover's giant numeral, or the first column of an index row. */
    number?: number | undefined;
    /** Marks the image as the likely LCP element (eager, high fetch priority). Use it for the cover only. */
    priority?: boolean;
}

const { project, updated, featured = false, number, priority = false } = Astro.props;
const { title, description, tech, status, repo, thumbnail } = project;

// From 1024px the cover's screenshot is the left 3fr of a 3fr/2fr grid, about 60% of the column (75vw), so 45vw; below
// that it is full width. A row image sits in a 16rem column from `lg:` (18rem at `md:`) and is full width below it. The
// width lists are what the browser may pick from: a 288px slot gets a 576 or 640px file, never a 2560px one. The cover
// tops out at 2560 because the screenshot is captured at 2x (2560px wide), and Astro drops widths above the source. A
// row goes to 960 so a 3x phone gets a sharp full-width image.
const sizes = featured
    ? '(min-width: 1024px) 45vw, calc(100vw - 2rem)'
    : '(min-width: 1024px) 256px, (min-width: 768px) 288px, calc(100vw - 2rem)';
const widths = featured ? [640, 960, 1280, 1920, 2560] : [320, 480, 640, 960];
// Reading order follows the DOM (WCAG 1.3.2), so the cover places the screenshot before the text and a row after it in
// the markup below, never with CSS `order`.
const screenshot = { src: thumbnail, title, widths, sizes, priority };

// The status square is decorative (the label text carries the meaning): filled vermilion for live, hollow for the rest.
const markerClass = status === 'live' ? 'bg-accent border-accent-deep' : 'border-ink-muted';
// With a thumbnail the cover is two columns from `lg:` (screenshot left, numeral and caption right); without one it
// stays a single column. A row reserves an image column only when it has an image.
const coverGrid = thumbnail ? 'lg:grid lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:items-start lg:gap-x-12' : '';
const rowGrid = thumbnail
    ? 'md:grid-cols-[5.5rem_1fr_18rem] lg:grid-cols-[5.5rem_1fr_16rem]'
    : 'md:grid-cols-[5.5rem_1fr]';
---

{/* The hover box is a box-shadow, not a border or outline: it takes no space, so nothing shifts when it appears. A thin
    accent-deep ring (the edge, which has contrast on paper) plus a heavier vermilion offset down and right (decorative)
    reads as slightly raised. It is transparent at rest, not removed, so only the colors transition. Padding keeps the
    content clear of the box; a negative margin cancels it (all round on the cover, sideways on a row) so the layout is as
    if there were no padding. A row has no vertical margin trick: its vertical padding makes the box end flush with the
    index rules on the li. `has-focus-visible` shows the box for keyboard focus anywhere in the card. */}
<article
    class:list={[
        'relative flex flex-col gap-5 transition-[box-shadow] duration-150 [box-shadow:0_0_0_1px_transparent,5px_5px_0_1px_transparent] hover:[box-shadow:0_0_0_1px_var(--color-accent-deep),5px_5px_0_1px_var(--color-accent)] has-focus-visible:[box-shadow:0_0_0_1px_var(--color-accent-deep),5px_5px_0_1px_var(--color-accent)] motion-reduce:transition-none',
        featured
            ? ['-m-2 p-2 md:gap-8 lg:-m-3 lg:p-3', coverGrid]
            : ['-mx-3 px-3 py-6 md:grid md:gap-x-gutter', rowGrid],
    ]}
>
    {featured && <ProjectScreenshot {...screenshot} />}
    {!featured && number !== undefined && (
        <span data-index class="font-display text-step-3 leading-none font-bold tracking-tight text-accent-deep">
            {formatNumber(number)}
        </span>
    )}
    <div
        class:list={[
            'flex gap-gutter',
            featured ? 'flex-col md:flex-row md:items-end lg:flex-col lg:items-start' : 'flex-col',
        ]}
    >
        {featured && number !== undefined && (
            <span data-index class="font-display text-step-6 leading-none font-bold tracking-tight text-accent-deep">
                {formatNumber(number)}
            </span>
        )}
        <div class="flex flex-1 flex-col gap-4">
            <div class="flex items-start justify-between gap-3">
                <Caption label={statusLabel(status)}>
                    <span
                        slot="label-marker"
                        aria-hidden="true"
                        class:list={['inline-block size-2.5 shrink-0 border', markerClass]}
                    />
                    <a
                        href={projectHref(project)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline-offset-4 after:absolute after:inset-0 hover:underline hover:decoration-accent-deep hover:decoration-2 focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:-outline-offset-4 focus-visible:after:outline-accent-deep"
                    >
                        {title}
                        <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                    <Fragment slot="byline">
                        <ul role="list" aria-label="Technologies" class="flex flex-wrap gap-1.5 font-mono">
                            {tech.map((name) => (
                                <li class="bg-paper-2 px-1.5 py-0.5 text-ink">{name}</li>
                            ))}
                        </ul>
                        {updated && (
                            <p class="mt-1.5">
                                Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
                            </p>
                        )}
                    </Fragment>
                </Caption>
                <a
                    href={repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${title} on GitHub (opens in a new tab)`}
                    class="relative z-10 -m-1 inline-flex size-9 shrink-0 items-center justify-center text-ink-muted hover:text-accent-deep"
                >
                    <GitHubIcon class="size-5" />
                </a>
            </div>
            <p class="max-w-measure">{description}</p>
        </div>
    </div>
    {!featured && <ProjectScreenshot {...screenshot} />}
</article>
