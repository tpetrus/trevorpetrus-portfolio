---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import { formatDate, isoDate } from '../lib/date';
import { projectHref, statusLabel } from '../lib/projects';
import GitHubIcon from './GitHubIcon.astro';

interface Props {
    project: CollectionEntry<'projects'>['data'];
    /** When the newest commit landed; the date line is omitted when the sync has not recorded one. */
    updated?: Date | undefined;
    /** The lead card: full width, image beside the text from `md:`. */
    featured?: boolean;
    /** Marks the image as the likely LCP element (eager, high fetch priority). Use it for the first card only. */
    priority?: boolean;
}

const { project, updated, featured = false, priority = false } = Astro.props;
const { title, description, tech, status, repo, thumbnail } = project;

const STATUS_STYLES = {
    live: 'border-ink bg-paper text-ink',
    'in-progress': 'border-ink bg-paper-2 text-ink',
    archived: 'border-ink-muted bg-paper text-ink-muted',
} as const;

// The featured image is about half of the 5xl content column from `md:`; the others sit in a 18rem-minimum grid.
const sizes = featured
    ? '(min-width: 1024px) 480px, (min-width: 768px) 50vw, calc(100vw - 3rem)'
    : '(min-width: 1024px) 320px, (min-width: 640px) 45vw, calc(100vw - 3rem)';
---

<article
    class:list={[
        'relative w-full overflow-hidden border border-ink bg-paper-2 transition-colors hover:border-accent-deep',
        featured ? 'md:grid md:grid-cols-2' : 'flex flex-col',
    ]}
>
    {thumbnail && (
        <Picture
            src={thumbnail}
            alt={`Screenshot of ${title}`}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 640, 960, 1280]}
            sizes={sizes}
            priority={priority}
            class:list={['h-auto w-full', featured && 'md:h-full md:object-cover']}
        />
    )}
    <div class="flex flex-col gap-4 p-5">
        <div class="flex items-start justify-between gap-3">
            <h2 class="text-step-1 font-bold">
                <a
                    href={projectHref(project)}
                    class="after:absolute after:inset-0 hover:underline focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-accent-deep"
                >
                    {title}
                </a>
            </h2>
            <a
                href={repo}
                aria-label={`${title} on GitHub`}
                class="relative z-10 -m-1 inline-flex size-9 shrink-0 items-center justify-center text-ink-muted hover:bg-paper hover:text-ink"
            >
                <GitHubIcon class="size-5" />
            </a>
        </div>
        <p class="text-ink-muted">{description}</p>
        <ul role="list" aria-label="Technologies" class="flex flex-wrap gap-2">
            {tech.map((name) => (
                <li class="bg-paper px-2.5 py-0.5 font-mono text-step-n1 text-ink">{name}</li>
            ))}
        </ul>
        <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 text-step-n1 text-ink-muted">
            <span class:list={['border px-2.5 py-0.5 font-medium', STATUS_STYLES[status]]}>{statusLabel(status)}</span>
            {updated && (
                <p>
                    Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
                </p>
            )}
        </div>
    </div>
</article>
