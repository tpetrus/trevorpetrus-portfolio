---
import { formatNumber } from '../lib/numbering';

interface Props {
    /** The rows in display order. Each row's content is the named slot that matches its `id`. */
    rows: readonly { id: string; number: number }[];
    /** Accessible name of the list. */
    label: string;
}

const { rows, label } = Astro.props;
---

{/* A numbered index: a 1px ink rule above every row, the zero-padded number in the display face, then the row's
    content (the slot named after its id). Numbers come from `numberItems`, so they stay put as rows are added. */}
<ul role="list" aria-label={label} class="border-b border-ink">
    {rows.map(({ id, number }) => (
        <li class="grid gap-x-gutter gap-y-3 border-t border-ink py-6 md:grid-cols-[5.5rem_1fr]">
            <span data-index class="font-display text-step-3 leading-none font-bold tracking-tight">
                {formatNumber(number)}
            </span>
            <slot name={id} />
        </li>
    ))}
</ul>
