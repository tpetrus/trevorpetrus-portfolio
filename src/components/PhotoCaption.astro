---
// The visible caption under a photo: the short tile line (for photography, only the place), as a small mono label.
// It renders nothing at all for an empty line, so a photo without a place has no empty paragraph. It stays its own
// component rather than the shared Caption because Caption's title is the loud display-caps line and its colors are for
// paper; a place name is not a title. The full camera line lives in the lightbox.
// It sits on the ink section, so its colors are the on-ink tokens.
interface Props {
    text: string;
}

const { text } = Astro.props;
---

{text !== '' && <p class="mt-3 font-mono text-step-n1 tracking-[0.02em] text-ink-muted-on-ink">{text}</p>}
