---
// A gallery page's body, shared by the Photography and Art pages: a jump nav, then one section per category (a gallery,
// or a short line while the category is empty), then the GeoNames credit when a derived place is shown. Grouping lives in gallerySections (src/lib/galleryView.ts).
import type { AnyCollectionCaption, GalleryCollectionName, GalleryEntry } from '../lib/gallery';
import { gallerySections } from '../lib/galleryView';
import { showsGeonamesPlace } from '../lib/location';
import Gallery from './Gallery.astro';
import GeonamesCredit from './GeonamesCredit.astro';
import SectionLegend from './SectionLegend.astro';

interface Props {
    collection: GalleryCollectionName;
    /** Every entry of the collection, in the data file's order. */
    entries: GalleryEntry<AnyCollectionCaption>[];
    /** The aria-label of the jump nav. */
    jumpLabel: string;
    /** Shown when the whole collection has no entries. */
    emptyLine: string;
    /** Shown in a category with no entries; takes the category's label. */
    sectionEmptyLine: (label: string) => string;
}

const { collection, entries, jumpLabel, emptyLine, sectionEmptyLine } = Astro.props;
const sections = gallerySections(collection, entries);
// Only the page's first photo can be the LCP image, so only the first section that has photos loads eagerly.
// A place can only be on a caption of a collection that uses places; a caption without a `location` key has none.
const showCredit = showsGeonamesPlace(
    entries.map(({ caption }) => ('location' in caption ? { caption } : { caption: {} })),
);
const firstFilledId = sections.find((section) => section.entries.length > 0)?.id;
---

{entries.length > 0 ? (
    <div class="mt-10 md:mt-14" data-sections-root>
        <nav aria-label={jumpLabel} data-jump-nav>
            <ul role="list" class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-step-n1 tracking-[0.06em] uppercase">
                {sections.map((section) => (
                    <li>
                        <a href={`#${section.id}`} class="link text-accent">
                            {section.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
        <SectionLegend sections={sections.map(({ id, label }) => ({ id, label }))} />
        {sections.map((section) => (
            <section id={section.id} aria-labelledby={`${section.id}-heading`} class="mt-12 md:mt-16">
                <div class="mb-6 flex items-center justify-between gap-4 md:mb-8">
                    <h2 id={`${section.id}-heading`} class="flex items-center gap-3 font-display text-step-2 font-bold">
                        <span aria-hidden="true" class="size-3 shrink-0 bg-accent" />
                        {section.label}
                    </h2>
                    <a
                        href="#main"
                        data-back-to-top
                        class="back-to-top -mr-3 inline-flex min-h-11 min-w-11 items-center justify-center text-paper hover:text-accent"
                    >
                        <span class="sr-only">Back to top</span>
                        <svg
                            aria-hidden="true"
                            focusable="false"
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="square"
                        >
                            <path d="M12 20V4M5 11l7-7 7 7" />
                        </svg>
                    </a>
                </div>
                {section.entries.length > 0 ? (
                    <Gallery collection={collection} entries={section.entries} eager={section.id === firstFilledId} />
                ) : (
                    <p class="max-w-measure text-ink-muted-on-ink">{sectionEmptyLine(section.label)}</p>
                )}
            </section>
        ))}
        {showCredit && <GeonamesCredit />}
    </div>
) : (
    <p class="mt-8 max-w-measure text-ink-muted-on-ink">{emptyLine}</p>
)}

<style>
    /* Hidden at the very top of the page once the script runs (it sets data-js), shown after any scroll. Without the
       script the links stay visible and plain `#main` anchors still work. */
    .back-to-top {
        transition:
            opacity 200ms ease,
            color 150ms ease,
            visibility 0s;
    }

    [data-sections-root][data-js]:not([data-scrolled]) .back-to-top {
        opacity: 0;
        visibility: hidden;
    }

    @media (prefers-reduced-motion: reduce) {
        .back-to-top {
            transition: none;
        }
    }
</style>
