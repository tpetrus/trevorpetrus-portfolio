---
import type { CollectionCaption, GalleryCollectionName, GalleryEntry } from '../lib/gallery';
import { galleryTiles } from '../lib/galleryView';
import PhotoCaption from './PhotoCaption.astro';

interface Props {
    /** Which collection the entries belong to; it decides how their captions read. */
    collection: GalleryCollectionName;
    entries: GalleryEntry<CollectionCaption>[];
}

const { collection, entries } = Astro.props;
const tiles = await galleryTiles(collection, entries);
---

<ul role="list" id="gallery" class="gallery">
    {tiles.map((tile) => (
        <li
            class="tile"
            style={`--row: ${tile.placement.row}; --column: ${tile.placement.column}; --span: ${tile.placement.span}`}
        >
            <a
                href={tile.href}
                data-pswp-width={tile.width}
                data-pswp-height={tile.height}
                data-pswp-srcset={tile.lightboxSrcset}
                data-original={tile.original}
                data-caption={tile.caption}
                class="photo"
            >
                <img
                    src={tile.src}
                    srcset={tile.srcset}
                    sizes={tile.sizes}
                    width={tile.width}
                    height={tile.height}
                    alt={tile.alt}
                    loading={tile.loading}
                    fetchpriority={tile.fetchpriority}
                    decoding="async"
                    style={{ backgroundImage: `url(${tile.placeholder})` }}
                    class="block h-auto w-full bg-cover transition-opacity hover:opacity-90"
                />
            </a>
            {tile.caption !== '' && <PhotoCaption text={tile.caption} />}
        </li>
    ))}
</ul>

<style>
    /* One column below 48rem (the breakpoint in src/lib/galleryLayout.ts), twelve above. */
    .gallery {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
    }

    .tile {
        display: flex;
        flex-direction: column;
        padding-bottom: calc(var(--spacing-gutter) * 3);
    }

    /*
     * The photo keeps its own height: a row's tiles differ in height, and stretching one would distort it. The explicit
     * width matters: without it, align-self makes the link shrink to its content, and an image that has not loaded yet
     * (every lazy one) would collapse to nothing instead of holding the space its width and height attributes reserve.
     */
    .photo {
        display: block;
        width: 100%;
        align-self: start;
    }

    @media (min-width: 48rem) {
        .gallery {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: var(--spacing-gutter);
        }

        /* Two grid rows per tile: the photo, then its caption. */
        .tile {
            grid-column: var(--column) / span var(--span);
            grid-row: calc(var(--row) * 2 + 1) / span 2;
            align-self: start;
        }
    }

    /*
     * With subgrid, the tiles of a row share both rows, so the captions line up under the tallest photo. Without it the
     * tile stays a flex column and each caption sits right under its own photo.
     */
    @supports (grid-template-rows: subgrid) {
        @media (min-width: 48rem) {
            .tile {
                display: grid;
                grid-template-rows: subgrid;
                align-self: stretch;
            }
        }
    }
</style>

<script>
    import '../scripts/galleryLightbox';
</script>
