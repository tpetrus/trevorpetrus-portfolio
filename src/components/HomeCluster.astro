---
import type { CollectionCaption, GalleryEntry } from '../lib/gallery';
import { clusterFigures } from '../lib/homeCluster';

interface Props {
    /** The photography entries, in the gallery's order; the cluster shows the first three. */
    entries: GalleryEntry<CollectionCaption>[];
}

const photos = await clusterFigures(Astro.props.entries);
---

{/* Renders nothing without photos, so the page needs no empty state. The photos deliberately carry no caption: the
    camera settings and the place live on the Photography page. */}
{photos.length > 0 && (
    <div class="cluster" data-home-cluster>
        {photos.map((photo) => (
            <img
                src={photo.src}
                srcset={photo.srcset}
                sizes={photo.sizes}
                width={photo.width}
                height={photo.height}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                style={{
                    aspectRatio: `${photo.width} / ${photo.height}`,
                    backgroundImage: `url(${photo.placeholder})`,
                }}
            />
        ))}
    </div>
)}

<style>
    /*
     * One composition at every width: twelve columns in one row of images, overlapping by a column. The first image spans
     * columns 1-5, the second 5-9, the third 9-12; the second and third are raised by a margin for the offset, and the
     * gap, the offsets and the images all scale with the cluster's width (a `cqi` unit is one percent of it), so a phone
     * shows the same arrangement as the desktop, smaller.
     */
    .cluster {
        container-type: inline-size;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 0.5rem;
        margin-block-start: 3rem;
    }

    img {
        grid-row: 1;
        align-self: end;
        inline-size: 100%;
        block-size: auto;
        background-size: cover;
        object-fit: cover;
        /* A paper-colored edge where an image overlaps another, so the two stay distinct. */
        outline: 0.25rem solid var(--color-paper);
    }

    img:nth-child(1) {
        grid-column: 1 / 6;
    }

    img:nth-child(2) {
        grid-column: 5 / 10;
        margin-block-end: 4.9cqi;
    }

    img:nth-child(3) {
        grid-column: 9 / 13;
        margin-block-end: 2.45cqi;
    }

    @media (min-width: 48rem) {
        .cluster {
            column-gap: var(--spacing-gutter);
        }
    }
</style>
