---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

import { NAV_ITEMS, isCurrentPage } from '../lib/nav';
import { THEME_COLOR } from '../lib/theme';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
const siteName = 'Trevor Petrus';
const pageTitle = `${title} | ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="color-scheme" content="light" />
        <meta name="theme-color" content={THEME_COLOR} />
        {/* Only Archivo is preloaded: it renders the h1, the likely LCP text. Inter and Plex Mono load on demand. */}
        <Font cssVariable="--font-archivo" preload />
        <Font cssVariable="--font-inter" />
        <Font cssVariable="--font-plex-mono" />
        <ClientRouter />
    </head>
    <body class="flex min-h-screen flex-col bg-paper font-sans text-ink antialiased">
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
        >
            Skip to main content
        </a>
        <header class="border-b border-ink">
            <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-edge py-4">
                <a href="/" class="font-display text-step-0 font-bold whitespace-nowrap">
                    {siteName}
                </a>
                <nav aria-label="Primary">
                    <ul class="flex gap-6">
                        {NAV_ITEMS.map(({ label, href }) => (
                            <li>
                                <a
                                    href={href}
                                    aria-current={isCurrentPage(Astro.url.pathname, href) ? 'page' : undefined}
                                    class="py-2 text-ink-muted underline-offset-4 hover:text-ink hover:underline aria-[current=page]:text-ink aria-[current=page]:underline"
                                >
                                    {label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </div>
        </header>
        <main id="main" tabindex="-1" class="mx-auto w-full max-w-5xl flex-1 px-edge py-12">
            <slot />
        </main>
        <footer class="border-t border-ink">
            <p class="mx-auto max-w-5xl px-edge py-6 font-mono text-step-n1 text-ink-muted">
                &copy; {new Date().getFullYear()} {siteName}
            </p>
        </footer>
    </body>
</html>
