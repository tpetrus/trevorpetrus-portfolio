{
  "extends": "astro/tsconfigs/strict",
  // .astro/types.d.ts is generated by `astro check` / `astro build`. tests/e2e is its own program
  // (tests/e2e/tsconfig.json) so its exports never show up as auto-imports in app code.
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["node_modules", "dist", "coverage", "tests/e2e", ".claude"],
  "compilerOptions": {
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": true
  }
}
