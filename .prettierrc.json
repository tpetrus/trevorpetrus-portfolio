{
  "plugins": ["prettier-plugin-astro"],
  "printWidth": 120,
  "tabWidth": 4,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.md", "*.yml", "*.yaml"],
      "options": { "tabWidth": 2 }
    },
    {
      "files": "src/content/**/*.yml",
      "options": { "singleQuote": false }
    },
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    }
  ]
}
