{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trevorpetrus-portfolio",
  "compatibility_date": "2026-10-08",
  // Static site: serve the Astro build in dist/. Unknown paths get the static 404 page if one exists (none yet), and
  // otherwise a plain 404.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Workers Builds runs `wrangler preview` for non-production branches, and that command fails unless this block
  // exists. It can be empty: assets and compatibility settings stay at the top level.
  "previews": {},
}
