{
  "name": "trevorpetrus-portfolio-site",
  "private": true,
  "type": "module",
  "version": "0.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "astro sync && eslint .",
    "typecheck": "astro check && tsc -p tests/e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "astro build",
    "size": "size-limit",
    "lighthouse": "lhci autorun && lhci autorun --collect.settings.preset=desktop --upload.outputDir=.lighthouseci/desktop",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "sync:projects": "esbuild scripts/sync-projects.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/sync-projects.mjs && node node_modules/.cache/sync-projects.mjs",
    "scaffold:gallery": "esbuild scripts/scaffold-gallery.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/scaffold-gallery.mjs && node node_modules/.cache/scaffold-gallery.mjs",
    "sync:gallery": "esbuild scripts/sync-gallery.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/sync-gallery.mjs && node node_modules/.cache/sync-gallery.mjs",
    "test:smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/smoke.mjs && node node_modules/.cache/smoke.mjs",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.2",
    "photoswipe": "^5.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "exifr": "^7.1.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  }
}
